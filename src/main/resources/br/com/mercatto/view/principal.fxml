<?xml version="1.0" encoding="UTF-8" ?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.SVGPath?>
<BorderPane
    xmlns="http://javafx.com/javafx/21"
    xmlns:fx="http://javafx.com/fxml/1"
    fx:controller="br.com.mercatto.controller.PrincipalController"
    fx:id="principalRoot"
    styleClass="mercatto-root"
    prefWidth="1280.0"
    prefHeight="760.0"
    minWidth="1060.0"
    minHeight="675.0"
    stylesheets="@../css/mercatto.css"
>
    <left>
        <VBox fx:id="menuLateral" styleClass="sidebar" prefWidth="216.0" minWidth="216.0" maxWidth="216.0">
            <VBox styleClass="sidebar-brand">
                <HBox alignment="CENTER_LEFT" spacing="10.0">
                    <StackPane
                        styleClass="brand-mark"
                        minWidth="38.0"
                        prefWidth="38.0"
                        maxWidth="38.0"
                        minHeight="38.0"
                        prefHeight="38.0"
                        maxHeight="38.0"
                    >
                        <SVGPath content="M5 7 H19 L20 21 H4 Z M8 7 V5 A4 4 0 0 1 16 5 V7" styleClass="brand-icon" />
                    </StackPane>
                    <Label text="Mercatto" styleClass="brand-word" />
                </HBox>
            </VBox>
            <Label text="OPERAÇÃO" styleClass="nav-section" />
            <Button
                fx:id="btnMenuPdv"
                onAction="#abrirPdv"
                text="Ponto de venda"
                styleClass="nav-item, nav-item-active"
                mnemonicParsing="false"
                maxWidth="1.7976931348623157E308"
                minWidth="-Infinity"
            >
                <graphic>
                    <SVGPath
                        content="M2 3 H5 L8 16 H19 L22 7 H6 M9 21 A1 1 0 1 1 9 19 A1 1 0 1 1 9 21 M18 21 A1 1 0 1 1 18 19 A1 1 0 1 1 18 21"
                        styleClass="icon"
                    />
                </graphic>
            </Button>
            <Label text="CADASTROS" styleClass="nav-section" />
            <Button
                fx:id="btnMenuProdutos"
                onAction="#abrirProdutos"
                text="Produtos"
                styleClass="nav-item"
                mnemonicParsing="false"
                maxWidth="1.7976931348623157E308"
                minWidth="-Infinity"
            >
                <graphic>
                    <SVGPath
                        content="M3 7 L12 2 L21 7 V17 L12 22 L3 17 Z M3 7 L12 12 L21 7 M12 12 V22 M7.5 4.5 L16.5 9.5"
                        styleClass="icon"
                    />
                </graphic>
            </Button>
            <Button
                fx:id="btnMenuClientes"
                onAction="#abrirClientes"
                text="Clientes"
                styleClass="nav-item"
                mnemonicParsing="false"
                maxWidth="1.7976931348623157E308"
                minWidth="-Infinity"
            >
                <graphic>
                    <SVGPath
                        content="M16 21 v-2 a4 4 0 0 0 -4 -4 H6 a4 4 0 0 0 -4 4 v2 M16 3 a4 4 0 0 1 0 8 M22 21 v-2 a4 4 0 0 0 -3 -3.87 M13 7 a4 4 0 1 1 -8 0 a4 4 0 1 1 8 0"
                        styleClass="icon"
                    />
                </graphic>
            </Button>
            <Label text="CONSULTAS" styleClass="nav-section" />
            <Button
                fx:id="btnMenuVendas"
                onAction="#abrirVendas"
                text="Vendas realizadas"
                styleClass="nav-item"
                mnemonicParsing="false"
                maxWidth="1.7976931348623157E308"
                minWidth="-Infinity"
            >
                <graphic>
                    <SVGPath
                        content="M5 3 L7 5 L9 3 L12 5 L15 3 L17 5 L19 3 V21 L17 19 L15 21 L12 19 L9 21 L7 19 L5 21 Z M9 9 H15 M9 13 H15"
                        styleClass="icon"
                    />
                </graphic>
            </Button>
            <Region VBox.vgrow="ALWAYS" />
            <Separator />
            <VBox spacing="5.0" styleClass="sidebar-footer">
                <Label text="Mercatto ERP" styleClass="sidebar-footer-title" />
                <Label text="Gestão para o varejo" styleClass="sidebar-footer-copy" />
            </VBox>
        </VBox>
    </left>
    <center>
        <BorderPane fx:id="areaConteudo">
            <top>
                <HBox alignment="CENTER_LEFT" spacing="14.0" styleClass="topbar">
                    <Label text="Seu negócio, em um só lugar." styleClass="topbar-label" />
                    <Region HBox.hgrow="ALWAYS" />
                    <Label fx:id="labelDadosTemporarios" text="Dados temporários" styleClass="status-pill">
                        <tooltip>
                            <Tooltip text="Os dados são descartados ao fechar o aplicativo." />
                        </tooltip>
                    </Label>
                </HBox>
            </top>
            <center>
                <fx:include fx:id="conteudoPdv" source="pdv.fxml" />
            </center>
        </BorderPane>
    </center>
</BorderPane>
